littlelegion.app {
    root * /srv/littlelegion
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }
    @assets path /assets/*
    header @assets Cache-Control "public, max-age=3600"
    # Serve clean URLs without redirecting /privacy to /privacy/.
    @pages path /privacy /support /tos
    rewrite @pages {path}/index.html
    file_server {
        hide .*
    }
    handle_errors {
        rewrite * /404/index.html
        file_server
    }
}
