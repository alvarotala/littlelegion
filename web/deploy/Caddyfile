server-us-1.littlelegion.app {
    reverse_proxy nakama:7350
}

import /etc/caddy/littlelegion.caddy

# Loopback-only preview port published by Compose.
:8080 {
    root * /srv/littlelegion
    encode zstd gzip
    @pages path /privacy /support /tos
    rewrite @pages {path}/index.html
    file_server
    handle_errors {
        rewrite * /404/index.html
        file_server
    }
}
